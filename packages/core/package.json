{
  "name": "@colomind/core",
  "version": "0.2.2",
  "description": "ColoMind Agent Runtime Core - Multi-modal AI × Security Guardian × Charter System",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "colomind": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/colomind/colomind.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@colomind/sentinel": "*",
    "@colomind/types": "*",
    "@hono/node-server": "^2.0.2",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.12.18",
    "llm-guard": "^0.1.8",
    "pg": "^8.13.0",
    "pyodide": "^0.26.2",
    "sharp": "^0.32.6",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.11.10",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
