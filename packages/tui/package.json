{
  "name": "@nexusmind/tui",
  "version": "0.1.0",
  "description": "NexusMind 终端界面",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexusmind-tui": "./dist/cli.js"
  },
  "exports": {
