{
  "name": "@colomind/tui",
  "version": "1.0.0",
  "description": "ColoMind Terminal UI",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "colomind-tui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/colomind/colomind.git",
    "directory": "packages/tui"
  },
  "scripts": {
    "build": "tsc && cp src/cli.js dist/cli.js",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@colomind/core": "*",
    "@colomind/types": "*",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
