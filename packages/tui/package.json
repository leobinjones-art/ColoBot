    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexusmind/core": "*",
    "@nexusmind/types": "*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
