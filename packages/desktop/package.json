{
  "name": "@colomind/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "npx npm-run-all --parallel sidecar dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar": "tsx sidecar/index.ts",
    "build:sidecar": "npx esbuild sidecar/index.ts --bundle --platform=node --outdir=dist-sidecar --format=cjs --external:better-sqlite3 --external:onnxruntime-node --external:sharp --external:@xenova/transformers --out-extension:.js=.cjs",
    "tauri:dev": "npm run sidecar & npx tauri dev",
    "tauri:build": "npm run build && npm run build:sidecar && npx tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "svelte": "^5",
    "svelte-spa-router": "^4",
    "highlight.js": "^11",
    "marked": "^18",
    "hono": "^4",
    "@hono/node-server": "^1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "@tailwindcss/vite": "^4",
    "typescript": "^5.7",
    "vite": "^6",
    "tsx": "^4"
  }
}
