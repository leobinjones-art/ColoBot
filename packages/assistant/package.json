{
  "name": "@colomind/assistant",
  "version": "0.1.1",
  "description": "ColoMind Personal Assistant - Personal information management and intelligent assistance",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./task": {
      "import": "./dist/task/index.js",
      "types": "./dist/task/index.d.ts"
    },
    "./schedule": {
      "import": "./dist/schedule/index.js",
      "types": "./dist/schedule/index.d.ts"
    },
    "./knowledge": {
      "import": "./dist/knowledge/index.js",
      "types": "./dist/knowledge/index.d.ts"
    },
    "./life": {
      "import": "./dist/life/index.js",
      "types": "./dist/life/index.d.ts"
    },
    "./growth": {
      "import": "./dist/growth/index.js",
      "types": "./dist/growth/index.d.ts"
    },
    "./intent": {
      "import": "./dist/intent/index.js",
      "types": "./dist/intent/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/colomind/colomind.git",
    "directory": "packages/assistant"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@colomind/core": "*",
    "@colomind/types": "*",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
