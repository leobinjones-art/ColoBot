{
  "name": "colomind",
  "version": "1.0.0",
  "description": "TypeScript AI Agent Framework with Built-in Security Guardian",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "colomind": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sentinel": {
      "import": "./dist/sentinel.js",
      "types": "./dist/sentinel.d.ts"
    },
    "./assistant": {
      "import": "./dist/assistant.js",
      "types": "./dist/assistant.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@colomind/types": "^1.0.0",
    "@colomind/core": "^1.0.0",
    "@colomind/sentinel": "^1.0.0",
    "@colomind/charter": "^1.0.0",
    "@colomind/tui": "^1.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colomind/colomind.git"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "security",
    "assistant",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
